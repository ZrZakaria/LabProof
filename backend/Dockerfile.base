# Base image with heavy ML dependencies pre-installed.
# Build once: docker build -f Dockerfile.base -t labproof-base .
# Rebuild only when torch/transformers/sentence-transformers versions change.

FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

# System deps for psycopg (libpq) and pypdf
RUN apt-get update \
    && apt-get install -y --no-install-recommends libpq5 gcc \
    && rm -rf /var/lib/apt/lists/*

# Install heavy ML deps (one-time cost ~2-3 min)
# torch from CPU index, rest from PyPI
RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu torch==2.14.1 \
    && pip install --no-cache-dir \
    transformers==5.19.0 \
    sentence-transformers==5.7.0 \
    scikit-learn==1.9.1 \
    scipy==1.18.1 \
    numpy==2.5.4

# Create non-root user for security (optional but good practice)
RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /home/appuser
USER appuser

WORKDIR /app