# LabProof configuration. Copy to .env and adjust. Never commit .env.

# --- Infrastructure ---------------------------------------------------------
LABPROOF_DATABASE_URL=postgresql://labproof:labproof@localhost:5432/labproof
LABPROOF_OLLAMA_URL=http://localhost:11434
LABPROOF_CORS_ORIGINS=["http://localhost:4200"]

# --- Models (all local, all free) -------------------------------------------
# Generation: qwen3.5:4b (16 GB RAM) or qwen3.5:2b (8 GB RAM fallback)
LABPROOF_LLM_MODEL=qwen3.5:4b
# Embeddings: bge-m3 is 1024-dim, multilingual, MIT licence
LABPROOF_EMBED_MODEL=bge-m3
LABPROOF_EMBED_DIM=1024
# Reranker: BAAI/bge-reranker-v2-m3. Empty string disables it (8 GB RAM fallback)
LABPROOF_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# NLI verifier: mDeBERTa-v3-base-xnli-multilingual-nli-2mil7. Empty disables verification
LABPROOF_NLI_MODEL=MoritzLaurer/mDeBERTa-v3-base-xnli-multilingual-nli-2mil7
LABPROOF_LLM_NUM_CTX=8192
LABPROOF_LLM_TIMEOUT_S=300.0

# --- Ingestion --------------------------------------------------------------
LABPROOF_CHUNK_MAX_CHARS=1200
LABPROOF_CHUNK_OVERLAP_CHARS=200
LABPROOF_MAX_UPLOAD_MB=25

# --- Retrieval --------------------------------------------------------------
# dense | fts | hybrid
LABPROOF_RETRIEVAL_MODE=hybrid
LABPROOF_CANDIDATES_PER_RETRIEVER=30
LABPROOF_RRF_K=60
LABPROOF_TOP_K=5
# Relevance gate: best rerank score below this -> abstain before calling the LLM.
# Calibrate on the dev split (Week 4). Start low to avoid false refusals.
LABPROOF_MIN_RERANK_SCORE=0.05

# --- Verification -----------------------------------------------------------
# P(entailment) needed to mark a sentence "supported"
LABPROOF_ENTAILMENT_THRESHOLD=0.5
# True -> drop unsupported sentences from the final answer
LABPROOF_STRICT_MODE=false

# --- API guard rails --------------------------------------------------------
LABPROOF_MAX_QUESTION_CHARS=1000